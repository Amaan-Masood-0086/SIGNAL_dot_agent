# SIGNAL backend — environment template. Copy to .env and fill secrets.
# NEVER commit .env; secrets come from environment only (backend MUST #6).

# REQUIRED — no silent default. Phase 1 MUST stay synthetic_only.
ENVIRONMENT=synthetic_only

# TWO database paths, and they are not interchangeable (audit F1).
#
# PRIVILEGED — the `signal` owner role. Used by migrations, by /auth/token
# (which must find a staff row by email BEFORE any institution is known), and
# by the admin console's documented cross-institution reads. Pointing this at
# `signal_app` breaks migrations, because that role deliberately cannot
# create objects.
DATABASE_URL=postgresql+psycopg://signal:signal_dev_only@localhost:5432/signal_dev

# TENANT — the unprivileged `signal_app` role created by migration 0001, so
# row-level security actually binds. Everything caretaker-facing goes through
# this. REQUIRED: there is no fallback to DATABASE_URL, because falling back
# would silently restore the state where RLS is enabled but never enforced,
# and a deployment in that state looks perfectly healthy from the outside.
# The app refuses to serve caretaker traffic if this is unset, or if the role
# it names turns out to be a superuser or to hold BYPASSRLS.
TENANT_DATABASE_URL=postgresql+psycopg://signal_app:signal_app@localhost:5432/signal_dev

# Test runner only — the suite creates and drops schema, so it needs the
# privileged role. Tests refuse to run on anything but PostgreSQL: RLS is a
# FEAT-01 acceptance criterion and is Postgres-only.
SIGNAL_TEST_DATABASE_URL=postgresql+psycopg://signal:signal_dev_only@localhost:5432/signal_dev

# RS256 keypair (PEM). Generate for local dev:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=signal-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# REQUIRED (ADR-10) — Fernet master key encrypting provider_credentials at
# rest. Generate: python scripts/make_credential_key.py (or Fernet.generate_key()).
# Treat like the JWT keys: never commit, never log; regenerating makes all
# stored credentials undecryptable (rotation procedure = Track B).
CREDENTIAL_ENCRYPTION_KEY=

# LLM provider (FEAT-05 reasoning pipeline) — env-only per ADR-09.
# "none" = unconfigured: synthetic_only environments fall back to the
# deterministic synthetic reasoner; anything else gets a clean 503.
LLM_PROVIDER=none
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=            # OpenAI-compatible; defaults to api.openai.com/v1
# Optional resilience endpoint (circuit breaker failover):
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_BASE_URL=
# Best-effort cost model ($ per 1M tokens) for the usage ledger:
# LLM_COST_PER_MILLION_INPUT=0.15
# LLM_COST_PER_MILLION_OUTPUT=0.60

# STT (FEAT-03) — "azure", "knowlez", or "none". The seam selects the adapter
# from this value; it does not assume Azure.
# STT_PROVIDER=none
# Azure:
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# Knowlez (Urdu-capable):
# KNOWLEZ_STT_API_KEY=
# STT_LANGUAGE=ur-PK
