# SIGNAL frontend — environment template. Copy to .env.local and adjust.
# Server-only (NO NEXT_PUBLIC_ prefix — never expose backend URLs/secrets
# to the browser bundle, web-development.md MUST #15 / MUST-NOT #3).
BACKEND_URL=http://localhost:8000

# Comma-separated extra origins the CSRF check will trust, for when the app is
# served through a reverse proxy or dev tunnel (the Host reaching the server
# is then localhost, not the public origin the browser sends). Leave unset for
# same-origin only. NEVER wildcard this.
# APP_ALLOWED_ORIGINS=https://your-tunnel.devtunnels.ms
